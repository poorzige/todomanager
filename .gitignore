# 运行时产物不进仓库：数据、备份、日志、导出物
tasks.json
tasks.json.bak
todo.md
*.log

# 环境与缓存
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.DS_Store
# 自动检测文本文件，并在仓库中将换行符统一规范为 LF
* text=auto eol=lf

# 明确指定某些必须使用 CRLF 的文件类型（如 Windows 批处理脚本）
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 确保 Shell 脚本使用 LF（否则在 Linux 上会报错）
*.sh text eol=lf

# 告诉 Git 二进制文件不要进行任何换行符转换
*.png binary
*.jpg binary
*.pyc binary